@model LigaNOS.Models.StatViewModel
 
  


<h2>Score</h2>
<table class="table">
    <thead>
        <tr>
            <th>Club Name</th>
            <th>Points</th>
            <th>Goals Scored</th>
            <th>Goals Conceded</th>
            <th>Wins</th>
            <th>Losses</th>
            <th>Draws</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var club in Model.ClubStats)
        {
            <tr>
                
                <td style="display: flex; align-items: center;">
                    
                    <img src="@club.ClubSymbol" alt="@club.ClubName" style="width: 20px; height: 20px; margin-right: 10px;" />
                    <span>@club.ClubName</span>
                </td>
                <td>@club.Points</td>
                <td>@club.GoalsScored</td>
                <td>@club.GoalsConceded</td>
                <td>@club.Wins</td>
                <td>@club.Losses</td>
                <td>@club.Draws</td>
            </tr>
        }
    </tbody>
</table>
<h2>Realized Games</h2>
<table class="table">
    <thead>
        <tr>
            <th>Home Team</th>
            <th>Away Team</th>
            <th>Home Goals</th>
            <th>Away Goals</th>
            <th>Date</th>
            <th>Time</th>
            <th>Stadium</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var match in Model.MatchResults)
        {
            <tr>
                <td>@match.HomeClub</td>
                <td>@match.AwayClub</td>
                <td>@match.HomeGoals</td>
                <td>@match.AwayGoals</td>
                <td>@match.MatchDay.ToShortDateString()</td>
                <td>@match.MatchTime</td>
                <td>@match.Stadium</td>
            </tr>
        }
    </tbody>
</table>