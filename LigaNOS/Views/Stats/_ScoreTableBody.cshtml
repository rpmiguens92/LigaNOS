@model LigaNOS.Models.StatViewModel

<tbody>
    @foreach (var club in Model.ClubStats)
    {
        <tr>
            <td>
                <img src="@club.ImageFullPath" alt="@club.ClubName" style="width: 20px; height: 20px; margin-right: 10px;" />
                <span>@club.ClubName </span>
            </td>
            <td>@club.Points</td>
            <td>@club.GoalsScored</td>
            <td>@club.GoalsConceded</td>
            <td>@club.Wins</td>
            <td>@club.Losses</td>
            <td>@club.Draws</td>
        </tr>
    }
</tbody>