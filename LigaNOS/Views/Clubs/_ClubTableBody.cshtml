@model IEnumerable<LigaNOS.Data.Entities.Club>

@{
    ViewData["Title"] = "_ClubTableBody";
}


<tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>
                <img src="@item.ImageFullPath" alt="@item.Name Symbol" style="width: 100px; height: auto;" />
            </td>
            <td>@Html.DisplayFor(modelItem => item.Name)</td>
            <td>@Html.DisplayFor(modelItem => item.Coach)</td>
            <td>@Html.DisplayFor(modelItem => item.Stadium)</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Edit</a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info">Details</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger" id="btnDelete">Delete</a>
            </td>
        </tr>
    }
</tbody>