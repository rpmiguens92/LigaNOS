@model IEnumerable<LigaNOS.Data.Entities.Club>
@{
    ViewData["Title"] = "Index";
}

<h3>Clubs</h3>

<p>

</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ImageFile)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Coach)
            </th>
           
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.ImageFile)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Coach)
                </td>
          
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ClubId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.ClubId">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.ClubId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<a asp-action="Create" class="btn btn-primary">Create New Club</a>