@model LigaNOS.Data.Entities.Match
@{
    ViewData["Title"] = "Delete";
}

 

<h3>Are you sure you want to delete this Player?</h3>


<dl class="row">

    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.HomeClub)
    </dd>
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.AwayClub)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.AwayClub)
    </dd>
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.HomeGoals)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.AwayGoals)
    </dd>
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.MatchDay)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.MatchTime)
    </dd>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.Stadium)
    </dd>


    <form asp-action="Delete">
        <input type="hidden" asp-for="MatchId" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
    </div>
