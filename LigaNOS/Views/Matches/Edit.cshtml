@model LigaNOS.Data.Entities.Match
@{
    ViewData["Title"] = "Edit";
}



<h1>Edit</h1>

<div class="row">
    <div class="col-md-4">

        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="MatchId" />
            <div class="col-md-4">

                <div class="form-group">
                    <label asp-for="HomeClub" class="control-label"></label>
                    <input asp-for="HomeClub" class="form-control" type="file" />
                    <span asp-validation-for="HomeClub" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="AwayClub" class="control-label"></label>
                    <input asp-for="AwayClub" class="form-control" />
                    <span asp-validation-for="AwayClub" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="HomeGoals" class="control-label"></label>
                    <input asp-for="HomeGoals" class="form-control" />
                    <span asp-validation-for="HomeGoals" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="AwayGoals"  class="control-label"></label>
                    <input asp-for="AwayGoals" class="form-control" />
                    <span asp-validation-for="AwayGoals" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="MatchDay" class="control-label"></label>
                    <input asp-for="MatchDay" class="form-control" />
                    <span asp-validation-for="MatchDay" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="MatchTime" class="control-label"></label>
                    <input asp-for="MatchTime" class="form-control" />
                    <span asp-validation-for="MatchTime" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Stadium" class="control-label"></label>
                    <input asp-for="Stadium" class="form-control" />
                    <span asp-validation-for="Stadium" class="text-danger"></span>
                </div>
            </div>
        </form>
    </div>
    <div class="form-group">
        <input type="submit" value="Save" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-success">Back to List</a>
    </div>
</div>