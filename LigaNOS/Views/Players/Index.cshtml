@model LigaNOS.Models.PlayersAndClubsViewModel

<h3>Players</h3>

<p>
    <a asp-action="Create" class="btn btn-primary">Add New Player</a>
</p>

@if (!Model.Players?.Any() ?? true)

{
    <p>No players available.</p>
}

else

{
    <table class="table">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Players.First().Name)</th>
                <th>@Html.DisplayNameFor(model => model.Players.First().Position)</th>
                <th>@Html.DisplayNameFor(model => model.Players.First().DateOfBirth)</th>
                <th>@Html.DisplayNameFor(model => model.Players.First().ImageFileId)</th>
                <th>@Html.DisplayNameFor(model => model.Players.First().Clubs.Name)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Players)

            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Name)</td>
                    <td>@Html.DisplayFor(modelItem => item.Position)</td>
                    <td>@Html.DisplayFor(modelItem => item.DateOfBirth)</td>
                    <td>
                    <td>
                        <img src="@item.ImageFullPath" alt="@item.Name "Photo" style="width: 100px; height: auto;" />
                    </td>
                    </td>
                    <td>@Html.DisplayFor(modelItem => item.Clubs.Name)</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger" id="btnDelete">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>


}